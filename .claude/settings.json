{
	"permissions": {
		"allow": [
			"Bash(bun run typecheck)",
			"Bash(bun run check)",
			"Bash(bun run lint)",
			"Bash(bun run format)",
			"Bash(bun run db:generate)",
			"Bash(bun test)",
			"Bash(bun test *)"
		],
		"ask": [
			"Bash(bun run db:migrate)",
			"Bash(bun run db:migrate *)",
			"Bash(bun run db:migrate:prod)",
			"Bash(bun run db:push)",
			"Bash(bunx prisma migrate dev *)",
			"Bash(bunx prisma migrate deploy *)",
			"Bash(bunx prisma db push *)"
		],
		"deny": [
			"Bash(bun run db:reset)",
			"Bash(bun run db:reset *)",
			"Bash(bunx prisma migrate reset *)"
		]
	},
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
					}
				]
			}
		]
	}
}
